// esperado: Erro sintático [SIN-001] na linha 3, coluna 17: esperado nome da espécie entre aspas, encontrado 'Cy'
// Erro: o nome da espécie precisa estar entre aspas
species molecule Cyclopentene {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    8x atom H as h

    bond c1=c2
    bond c2-c3
    bond c3-c4
    bond c4-c5
    bond c1-c5
    bond c1-h1
    bond c2-h2
    bond c3-h3
    bond c3-h4
    bond c4-h5
    bond c4-h6
    bond c5-h7
    bond c5-h8

    ring c1 c2 c3 c4 c5
}
