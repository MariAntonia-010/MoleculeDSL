// esperado: Erro sintático [SIN-002] na linha 10, coluna 4: comando inválido 'bnd': esperado 'atom', 'bond', 'ring', 'stereo', 'configuration' ou '}'
// Erro: 'bnd' não é palavra-chave da linguagem
species molecule "But-1-yne" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    6x atom H as h

    bnd c1#c2
    bond c2-c3
    bond c3-c4
    bond c1-h1
    bond c3-h2
    bond c3-h3
    bond c4-h4
    bond c4-h5
    bond c4-h6
}
