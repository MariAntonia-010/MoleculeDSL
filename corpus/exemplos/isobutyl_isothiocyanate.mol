// Isobutyl isothiocyanate (S=C=NCC(C)C)
species molecule "Isobutyl isothiocyanate" {
    atom S as s1
    atom C as c1
    atom N as n1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    9x atom H as h

    bond s1=c1
    bond c1=n1
    bond n1-c2
    bond c2-c3
    bond c3-c4
    bond c3-c5
    bond c2-h1
    bond c2-h2
    bond c3-h3
    bond c4-h4
    bond c4-h5
    bond c4-h6
    bond c5-h7
    bond c5-h8
    bond c5-h9
}
