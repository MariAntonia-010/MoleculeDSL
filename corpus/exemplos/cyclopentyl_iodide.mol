// Cyclopentyl iodide (IC1CCCC1)
species molecule "Cyclopentyl iodide" {
    atom I as i1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    9x atom H as h

    bond i1-c1
    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c4-c5
    bond c1-c5
    bond c1-h1
    bond c2-h2
    bond c2-h3
    bond c3-h4
    bond c3-h5
    bond c4-h6
    bond c4-h7
    bond c5-h8
    bond c5-h9

    ring c1 c2 c3 c4 c5
}
