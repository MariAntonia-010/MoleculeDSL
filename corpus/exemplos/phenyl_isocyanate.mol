// Phenyl isocyanate (O=C=NC1=CC=CC=C1)
species molecule "Phenyl isocyanate" {
    atom O as o1
    atom C as c1
    atom N as n1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    atom C as c6
    atom C as c7
    5x atom H as h

    bond o1=c1
    bond c1=n1
    bond n1-c2
    bond c2=c3
    bond c3-c4
    bond c4=c5
    bond c5-c6
    bond c6=c7
    bond c2-c7
    bond c3-h1
    bond c4-h2
    bond c5-h3
    bond c6-h4
    bond c7-h5

    ring c2 c3 c4 c5 c6 c7
}
