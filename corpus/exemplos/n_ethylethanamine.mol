// N-Ethylethanamine (CCNCC)
species molecule "N-Ethylethanamine" {
    atom C as c1
    atom C as c2
    atom N as n1
    atom C as c3
    atom C as c4
    11x atom H as h

    bond c1-c2
    bond c2-n1
    bond n1-c3
    bond c3-c4
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond n1-h6
    bond c3-h7
    bond c3-h8
    bond c4-h9
    bond c4-h10
    bond c4-h11
}
