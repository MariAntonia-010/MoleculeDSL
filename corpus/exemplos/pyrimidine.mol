// Pyrimidine (C1=CN=CN=C1)
species molecule "Pyrimidine" {
    atom C as c1
    atom C as c2
    atom N as n1
    atom C as c3
    atom N as n2
    atom C as c4
    4x atom H as h

    bond c1=c2
    bond c2-n1
    bond n1=c3
    bond c3-n2
    bond n2=c4
    bond c1-c4
    bond c1-h1
    bond c2-h2
    bond c3-h3
    bond c4-h4

    ring c1 c2 n1 c3 n2 c4
}
