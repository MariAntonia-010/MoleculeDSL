// Butan-1-amine (CCCCN)
species molecule "Butan-1-amine" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom N as n1
    11x atom H as h

    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c4-n1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c3-h7
    bond c4-h8
    bond c4-h9
    bond n1-h10
    bond n1-h11
}
