// Ethyl isocyanate (O=C=NCC)
species molecule "Ethyl isocyanate" {
    atom O as o1
    atom C as c1
    atom N as n1
    atom C as c2
    atom C as c3
    5x atom H as h

    bond o1=c1
    bond c1=n1
    bond n1-c2
    bond c2-c3
    bond c2-h1
    bond c2-h2
    bond c3-h3
    bond c3-h4
    bond c3-h5
}
