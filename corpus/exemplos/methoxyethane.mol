// Methoxyethane (CCOC)
species molecule "Methoxyethane" {
    atom C as c1
    atom C as c2
    atom O as o1
    atom C as c3
    8x atom H as h

    bond c1-c2
    bond c2-o1
    bond o1-c3
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c3-h7
    bond c3-h8
}
