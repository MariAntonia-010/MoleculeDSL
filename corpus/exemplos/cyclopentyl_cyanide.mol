// Cyclopentyl cyanide (N#CC1CCCC1)
species molecule "Cyclopentyl cyanide" {
    atom N as n1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    atom C as c6
    9x atom H as h

    bond n1#c1
    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c4-c5
    bond c5-c6
    bond c2-c6
    bond c2-h1
    bond c3-h2
    bond c3-h3
    bond c4-h4
    bond c4-h5
    bond c5-h6
    bond c5-h7
    bond c6-h8
    bond c6-h9

    ring c2 c3 c4 c5 c6
}
