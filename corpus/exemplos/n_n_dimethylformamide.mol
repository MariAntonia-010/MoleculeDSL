// N,N-Dimethylformamide (CN(C)C=O)
species molecule "N,N-Dimethylformamide" {
    atom C as c1
    atom N as n1
    atom C as c2
    atom C as c3
    atom O as o1
    7x atom H as h

    bond c1-n1
    bond n1-c2
    bond n1-c3
    bond c3=o1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c2-h6
    bond c3-h7
}
