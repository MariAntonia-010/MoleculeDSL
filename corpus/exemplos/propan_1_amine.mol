// Propan-1-amine (CCCN)
species molecule "Propan-1-amine" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom N as n1
    9x atom H as h

    bond c1-c2
    bond c2-c3
    bond c3-n1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c3-h7
    bond n1-h8
    bond n1-h9
}
