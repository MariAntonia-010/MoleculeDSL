// Propyl acetate (CCCOC(C)=O)
species molecule "Propyl acetate" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom O as o1
    atom C as c4
    atom C as c5
    atom O as o2
    10x atom H as h

    bond c1-c2
    bond c2-c3
    bond c3-o1
    bond o1-c4
    bond c4-c5
    bond c4=o2
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c3-h7
    bond c5-h8
    bond c5-h9
    bond c5-h10
}
