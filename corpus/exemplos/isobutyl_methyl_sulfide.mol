// Isobutyl methyl sulfide (CSCC(C)C)
species molecule "Isobutyl methyl sulfide" {
    atom C as c1
    atom S as s1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    12x atom H as h

    bond c1-s1
    bond s1-c2
    bond c2-c3
    bond c3-c4
    bond c3-c5
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8
    bond c4-h9
    bond c5-h10
    bond c5-h11
    bond c5-h12
}
