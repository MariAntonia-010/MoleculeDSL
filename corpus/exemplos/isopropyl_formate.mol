// Isopropyl formate (O=COC(C)C)
species molecule "Isopropyl formate" {
    atom O as o1
    atom C as c1
    atom O as o2
    atom C as c2
    atom C as c3
    atom C as c4
    8x atom H as h

    bond o1=c1
    bond c1-o2
    bond o2-c2
    bond c2-c3
    bond c2-c4
    bond c1-h1
    bond c2-h2
    bond c3-h3
    bond c3-h4
    bond c3-h5
    bond c4-h6
    bond c4-h7
    bond c4-h8
}
