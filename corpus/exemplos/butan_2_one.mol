// Butan-2-one (CCC(C)=O)
species molecule "Butan-2-one" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom O as o1
    8x atom H as h

    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c3=o1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c4-h6
    bond c4-h7
    bond c4-h8
}
