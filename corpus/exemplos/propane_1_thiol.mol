// Propane-1-thiol (CCCS)
species molecule "Propane-1-thiol" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom S as s1
    8x atom H as h

    bond c1-c2
    bond c2-c3
    bond c3-s1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c3-h6
    bond c3-h7
    bond s1-h8
}
