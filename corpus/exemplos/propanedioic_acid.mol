// Propanedioic acid (OC(=O)CC(=O)O)
species molecule "Propanedioic acid" {
    atom O as o1
    atom C as c1
    atom O as o2
    atom C as c2
    atom C as c3
    atom O as o3
    atom O as o4
    4x atom H as h

    bond o1-c1
    bond c1=o2
    bond c1-c2
    bond c2-c3
    bond c3=o3
    bond c3-o4
    bond o1-h1
    bond c2-h2
    bond c2-h3
    bond o4-h4
}
