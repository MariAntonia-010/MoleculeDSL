// Cyclopentyl methyl ether (COC1CCCC1)
species molecule "Cyclopentyl methyl ether" {
    atom C as c1
    atom O as o1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    atom C as c6
    12x atom H as h

    bond c1-o1
    bond o1-c2
    bond c2-c3
    bond c3-c4
    bond c4-c5
    bond c5-c6
    bond c2-c6
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8
    bond c5-h9
    bond c5-h10
    bond c6-h11
    bond c6-h12

    ring c2 c3 c4 c5 c6
}
