// 2-Methylpropanal (CC(C)C=O)
species molecule "2-Methylpropanal" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom O as o1
    8x atom H as h

    bond c1-c2
    bond c2-c3
    bond c2-c4
    bond c4=o1
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c3-h7
    bond c4-h8
}
