// sec-Butyl iodide (IC(C)CC)
species molecule "sec-Butyl iodide" {
    atom I as i1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    9x atom H as h

    bond i1-c1
    bond c1-c2
    bond c1-c3
    bond c3-c4
    bond c1-h1
    bond c2-h2
    bond c2-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8
    bond c4-h9
}
