// Ethyl acetate (CCOC(C)=O)
species molecule "Ethyl acetate" {
    atom C as c1
    atom C as c2
    atom O as o1
    atom C as c3
    atom C as c4
    atom O as o2
    8x atom H as h

    bond c1-c2
    bond c2-o1
    bond o1-c3
    bond c3-c4
    bond c3=o2
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c2-h5
    bond c4-h6
    bond c4-h7
    bond c4-h8
}
