// Cyclobutyl fluoride (FC1CCC1)
species molecule "Cyclobutyl fluoride" {
    atom F as f1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    7x atom H as h

    bond f1-c1
    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c1-c4
    bond c1-h1
    bond c2-h2
    bond c2-h3
    bond c3-h4
    bond c3-h5
    bond c4-h6
    bond c4-h7

    ring c1 c2 c3 c4
}
