// Ethane-1,2-diamine (NCCN)
species molecule "Ethane-1,2-diamine" {
    atom N as n1
    atom C as c1
    atom C as c2
    atom N as n2
    8x atom H as h

    bond n1-c1
    bond c1-c2
    bond c2-n2
    bond n1-h1
    bond n1-h2
    bond c1-h3
    bond c1-h4
    bond c2-h5
    bond c2-h6
    bond n2-h7
    bond n2-h8
}
