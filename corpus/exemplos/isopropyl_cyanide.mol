// Isopropyl cyanide (N#CC(C)C)
species molecule "Isopropyl cyanide" {
    atom N as n1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    7x atom H as h

    bond n1#c1
    bond c1-c2
    bond c2-c3
    bond c2-c4
    bond c2-h1
    bond c3-h2
    bond c3-h3
    bond c3-h4
    bond c4-h5
    bond c4-h6
    bond c4-h7
}
