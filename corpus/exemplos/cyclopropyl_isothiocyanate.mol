// Cyclopropyl isothiocyanate (S=C=NC1CC1)
species molecule "Cyclopropyl isothiocyanate" {
    atom S as s1
    atom C as c1
    atom N as n1
    atom C as c2
    atom C as c3
    atom C as c4
    5x atom H as h

    bond s1=c1
    bond c1=n1
    bond n1-c2
    bond c2-c3
    bond c3-c4
    bond c2-c4
    bond c2-h1
    bond c3-h2
    bond c3-h3
    bond c4-h4
    bond c4-h5

    ring c2 c3 c4
}
