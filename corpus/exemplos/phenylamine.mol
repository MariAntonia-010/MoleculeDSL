// Phenylamine (NC1=CC=CC=C1)
species molecule "Phenylamine" {
    atom N as n1
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    atom C as c6
    7x atom H as h

    bond n1-c1
    bond c1=c2
    bond c2-c3
    bond c3=c4
    bond c4-c5
    bond c5=c6
    bond c1-c6
    bond n1-h1
    bond n1-h2
    bond c2-h3
    bond c3-h4
    bond c4-h5
    bond c5-h6
    bond c6-h7

    ring c1 c2 c3 c4 c5 c6
}
