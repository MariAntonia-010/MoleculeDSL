species molecule "Pent-2-yne" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    8x atom H as h

    atom Ne as ne1
    bond c1-c2
    bond c2#c3
    bond c3-c4
