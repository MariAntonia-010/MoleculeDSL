// esperado: Erro semântico [STRUCT-003] na linha 12, coluna 4: o átomo ne1 (Ne#1) não tem nenhuma ligação
// Erro: o neônio ne1 foi declarado mas não está ligado ao resto da molécula
species molecule "Oxane" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom O as o1
    atom C as c4
    atom C as c5
    10x atom H as h

    atom Ne as ne1
    bond c1-c2
    bond c2-c3
    bond c3-o1
    bond o1-c4
    bond c4-c5
    bond c1-c5
    bond c1-h1
    bond c1-h2
    bond c2-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8
    bond c5-h9
    bond c5-h10

    ring c1 c2 c3 o1 c4 c5
}
