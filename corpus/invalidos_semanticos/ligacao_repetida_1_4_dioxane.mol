// esperado: Erro semântico [STRUCT-006] na linha 28, coluna 4: já existe uma ligação entre c1 (C#1) e c2 (C#2); use = ou # para ligação dupla ou tripla
// Erro: 'bond c1-c2' aparece duas vezes
species molecule "1,4-Dioxane" {
    atom C as c1
    atom C as c2
    atom O as o1
    atom C as c3
    atom C as c4
    atom O as o2
    8x atom H as h

    bond c1-c2
    bond c2-o1
    bond o1-c3
    bond c3-c4
    bond c4-o2
    bond c1-o2
    bond c1-h1
    bond c1-h2
    bond c2-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8

    ring c1 c2 o1 c3 c4 o2
    bond c1-c2
}
