// esperado: Erro semântico [STRUCT-001] na linha 29, coluna 12: nenhum átomo se chama 'q9'
// Erro: q9 não foi declarado com 'as'
species molecule "Morpholine" {
    atom C as c1
    atom C as c2
    atom O as o1
    atom C as c3
    atom C as c4
    atom N as n1
    9x atom H as h

    bond c1-c2
    bond c2-o1
    bond o1-c3
    bond c3-c4
    bond c4-n1
    bond c1-n1
    bond c1-h1
    bond c1-h2
    bond c2-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c4-h7
    bond c4-h8
    bond n1-h9

    ring c1 c2 o1 c3 c4 n1
    bond c1-q9
}
