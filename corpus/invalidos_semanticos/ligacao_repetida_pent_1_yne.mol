// esperado: Erro semântico [STRUCT-006] na linha 23, coluna 4: já existe uma ligação entre c1 (C#1) e c2 (C#2); use = ou # para ligação dupla ou tripla
// Erro: 'bond c1#c2' aparece duas vezes
species molecule "Pent-1-yne" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    8x atom H as h

    bond c1#c2
    bond c2-c3
    bond c3-c4
    bond c4-c5
    bond c1-h1
    bond c3-h2
    bond c3-h3
    bond c4-h4
    bond c4-h5
    bond c5-h6
    bond c5-h7
    bond c5-h8
    bond c1#c2
}
