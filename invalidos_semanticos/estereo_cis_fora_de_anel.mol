// esperado: Erro semântico [STEREO-001] na linha 29, coluna 4: c2 (C#2) c3 (C#3): os centros não estão num anel comum com dois substituintes de fora distintos
molecule "Tartaric acid" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom O as o1
    atom O as o2
    atom O as o3
    atom O as o4
    atom O as o5
    atom O as o6
    6x atom H as h
    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c1=o1
    bond c1-o2
    bond c2-o3
    bond c3-o4
    bond c4=o5
    bond c4-o6
    bond c2-h1
    bond c3-h2
    bond o2-h3
    bond o3-h4
    bond o4-h5
    bond o6-h6
    stereo c2 c3 cis
}
