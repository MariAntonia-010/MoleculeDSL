// Ânion ciclopentadienila, C5H5-: 6 elétrons pi no anel de 5, aromático
species molecular_ion "Cyclopentadienide" charge -1 {
    4x atom C as c
    atom C(-1) as cm
    5x atom H as h
    bond c1=c2
    bond c2-c3
    bond c3=c4
    bond c4-cm
    bond cm-c1
    bond c1-h1
    bond c2-h2
    bond c3-h3
    bond c4-h4
    bond cm-h5
    ring c1 c2 c3 c4 cm
}
