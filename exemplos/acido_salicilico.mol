// Ácido salicílico (ácido 2-hidroxibenzoico): a hidroxila do anel é
// acetilada para dar a aspirina
species molecule "Salicylic acid" {
    7x atom C as c
    atom O as o1
    atom O as o2
    atom O as o3
    6x atom H as h

    bond c1=c2
    bond c2-c3
    bond c3=c4
    bond c4-c5
    bond c5=c6
    bond c6-c1

    bond c1-c7
    bond c7=o1
    bond c7-o2
    bond o2-h1
    bond c2-o3
    bond o3-h2

    bond c3-h3
    bond c4-h4
    bond c5-h5
    bond c6-h6

    ring c1 c2 c3 c4 c5 c6
}
