// esperado: Aviso semântico [SPEC-002] na linha 3, coluna 0: ionic_solid é uma estrutura estendida; o grafo representa apenas um motivo finito
// Cloreto de magnésio: motivo finito de um sólido iônico, Mg2+ entre dois Cl-
species ionic_solid "Magnesium chloride" {
    atom Mg(+2) as mg
    2x atom Cl(-1) as cl
    bond mg-cl1
    bond mg-cl2
}
