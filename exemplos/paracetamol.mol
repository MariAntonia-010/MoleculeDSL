// Paracetamol (N-(4-hidroxifenil)acetamida): fenol e amida em posição para
species molecule "Paracetamol" {
    8x atom C as c
    atom N as n
    atom O as o1
    atom O as o2
    9x atom H as h

    bond c1=c2
    bond c2-c3
    bond c3=c4
    bond c4-c5
    bond c5=c6
    bond c6-c1

    bond c1-o1
    bond o1-h1
    bond c4-n
    bond n-h2
    bond n-c7
    bond c7=o2
    bond c7-c8

    bond c2-h3
    bond c3-h4
    bond c5-h5
    bond c6-h6
    bond c8-h7
    bond c8-h8
    bond c8-h9

    ring c1 c2 c3 c4 c5 c6
}
