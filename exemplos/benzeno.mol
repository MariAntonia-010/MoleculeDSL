// Anel de 6 com ligações simples e duplas alternadas
molecule "Benzene" {
    6x atom C as c
    6x atom H as h

    bond c1=c2
    bond c2-c3
    bond c3=c4
    bond c4-c5
    bond c5=c6
    bond c6-c1

    bond c1-h1
    bond c2-h2
    bond c3-h3
    bond c4-h4
    bond c5-h5
    bond c6-h6

    ring c1 c2 c3 c4 c5 c6
}
