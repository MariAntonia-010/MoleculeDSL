// 2-Bromopropano: HBr se soma ao propeno pela regra de Markovnikov
// (o H vai para o carbono que já tem mais hidrogênios)
species molecule "2-Bromopropane" {
    3x atom C as c
    atom Br as br
    7x atom H as h

    bond c1-c2
    bond c2-c3
    bond c2-br
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c3-h5
    bond c3-h6
    bond c3-h7
}
