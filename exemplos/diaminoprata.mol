// esperado: Aviso semântico [COORD-004] na linha 13, coluna 4: não há dados suficientes para conferir orbital vazio de ag (Ag#1) (2 ligações coordenadas)
// Íon diaminoprata, [Ag(NH3)2]+: cada NH3 doa um par livre à prata (reagente de Tollens)
species molecular_ion "Diamminesilver(1+)" charge +1 {
    atom Ag(-1) as ag
    2x atom N(+1) as n
    6x atom H as h
    bond n1-h1
    bond n1-h2
    bond n1-h3
    bond n2-h4
    bond n2-h5
    bond n2-h6
    bond n1->ag
    bond n2->ag
}
