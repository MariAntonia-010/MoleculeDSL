// Hexa-2,3-dieno: aleno com quiralidade axial, declarada no carbono central
species molecule "(Ra)-Hexa-2,3-diene" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom C as c5
    atom C as c6
    10x atom H as h
    bond c1-c2
    bond c2=c3
    bond c3=c4
    bond c4-c5
    bond c5-c6
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c4-h5
    bond c5-h6
    bond c5-h7
    bond c6-h8
    bond c6-h9
    bond c6-h10
    stereo c3 Ra
}
