// (2R,3R)-2,3-diclorobutano: dois centros iguais com o mesmo descritor, forma quiral
species molecule "(2R,3R)-2,3-Dichlorobutane" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom C as c4
    atom Cl as cl1
    atom Cl as cl2
    8x atom H as h
    bond c1-c2
    bond c2-c3
    bond c3-c4
    bond c2-cl1
    bond c3-cl2
    bond c1-h1
    bond c1-h2
    bond c1-h3
    bond c2-h4
    bond c3-h5
    bond c4-h6
    bond c4-h7
    bond c4-h8
    stereo c2 R
    stereo c3 R
}
