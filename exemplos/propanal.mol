// Aldeído de três carbonos: carbonila na ponta da cadeia
molecule "Propanal" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom O as o
    6x atom H as h
    bond c1=o
    bond c1-h1
    bond c1-c2
    bond c2-c3
    bond c2-h2
    bond c2-h3
    bond c3-h4
    bond c3-h5
    bond c3-h6
}
