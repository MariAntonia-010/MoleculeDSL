// Ácido carboxílico de três carbonos
molecule "Propanoic acid" {
    atom C as c1
    atom C as c2
    atom C as c3
    atom O as o1
    atom O as o2
    6x atom H as h
    bond c1=o1
    bond c1-o2
    bond o2-h1
    bond c1-c2
    bond c2-c3
    bond c2-h2
    bond c2-h3
    bond c3-h4
    bond c3-h5
    bond c3-h6
}
