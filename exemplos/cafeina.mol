// Cafeína (1,3,7-trimetilpurina-2,6-diona): anel de 6 e anel de 5 que
// dividem a ligação c4=c5, com metilas em n1, n3 e n7
species molecule "Caffeine" {
    atom N as n1
    atom C as c2
    atom N as n3
    atom C as c4
    atom C as c5
    atom C as c6
    atom N as n7
    atom C as c8
    atom N as n9
    atom O as o2
    atom O as o6
    3x atom C as m
    10x atom H as h

    bond n1-c2
    bond c2-n3
    bond n3-c4
    bond c4=c5
    bond c5-c6
    bond c6-n1
    bond c5-n7
    bond n7-c8
    bond c8=n9
    bond n9-c4

    bond c2=o2
    bond c6=o6
    bond n1-m1
    bond n3-m2
    bond n7-m3
    bond c8-h1

    bond m1-h2
    bond m1-h3
    bond m1-h4
    bond m2-h5
    bond m2-h6
    bond m2-h7
    bond m3-h8
    bond m3-h9
    bond m3-h10

    ring n1 c2 n3 c4 c5 c6
    ring c4 c5 n7 c8 n9
}
