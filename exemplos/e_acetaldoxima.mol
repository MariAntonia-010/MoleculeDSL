// (E)-acetaldoxima: E/Z na dupla C=N, com o par livre do N como menor prioridade
species molecule "(E)-Acetaldehyde oxime" {
    atom C as c1
    atom C as c2
    atom N as n
    atom O as o
    5x atom H as h
    bond c1-c2
    bond c2=n
    bond n-o
    bond o-h1
    bond c2-h2
    bond c1-h3
    bond c1-h4
    bond c1-h5
    stereo c2=n E
}
